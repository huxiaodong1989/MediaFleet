# mediafleet 统一环境变量模板
# 使用方法：复制为 .env 后按部署角色修改。
# 禁止在本文件提交真实密码、密钥、摄像头地址或生产内网地址。

# ========================================
# 应用与时区
# ========================================
APP_NAME=流媒体处理服务
APP_VERSION=1.0.0
APP_ENV=development
APP_TIMEZONE=Asia/Shanghai
TZ=Asia/Shanghai
API_PREFIX=/api/v1
API_KEY=change-me
DEBUG=false

# ========================================
# 服务运行
# ========================================
SERVICE_NAME=流媒体处理服务
SERVICE_HOST=0.0.0.0
SERVICE_DOTENV_ENABLED=false
SERVICE_PORT=8008
SERVICE_DEBUG=false
SERVICE_LOG_LEVEL=INFO
SERVICE_LOG_DIR=logs

# ========================================
# Docker 镜像、端口与宿主机目录
# ========================================
CONTROL_CENTER_IMAGE=mediafleet-control-center:stable
RECORDER_NODE_IMAGE=mediafleet-recorder-node:stable
MEDIA_WORKER_IMAGE=mediafleet-worker:stable
CONTENT_ANALYSIS_IMAGE=mediafleet-content-analysis:stable
CONTROL_CENTER_HOST_IP=127.0.0.1
CONTROL_CENTER_PORT=8008
MEDIA_WORKER_HOST_IP=127.0.0.1
MEDIA_WORKER_PORT=8009
CONTENT_ANALYSIS_HOST_IP=127.0.0.1
CONTENT_ANALYSIS_PORT=8012
RECORDER_NODE_HOST_IP=127.0.0.1
RECORDER_NODE_PORT=8010
MEDIA_WORKER_GPU_0_PORT=8009
MEDIA_WORKER_GPU_1_PORT=8011
# 单服务独立部署时可指向各自环境文件；不配置则统一读取根目录 .env。
CONTROL_CENTER_ENV_FILE=../../.env
RECORDER_NODE_ENV_FILE=../../.env
MEDIA_WORKER_ENV_FILE=../../.env
CONTENT_ANALYSIS_ENV_FILE=../../.env
HOST_LOG_PATH=/opt/mediafleet/logs
HOST_UPLOADS_PATH=/opt/mediafleet/uploads
HOST_TEMP_PATH=/opt/mediafleet/temp
# Docker 宿主机上的 ZL www/record 目录，仅用于 Compose volume 左侧。
# Windows 示例：E:/Test/ZLMediaKit/Debug/www/record
# Linux 示例：/srv/mediafleet/www/record
ZLM_RECORD_PATH=/data/app/zlmediakit/www/record
YOLO_MODEL_PATH=resource/models/yolo/yolov8n_head_100.pt

# ========================================
# 数据库：mysql 或 dm
# ========================================
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mediafleet
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# 开发/测试空库可设 true；生产结构迁移建议 false 并由 Alembic 执行。
DB_AUTO_INIT=true
# 开发/测试启动调用中心时自动执行 Alembic upgrade head；生产多实例建议 false。
DB_AUTO_MIGRATE=true
DB_INIT_CREATE_SCHEMA=true
DB_DM_MYSQL_COMPAT=true

# ========================================
# Redis
# ========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_POOL_SIZE=10

# ========================================
# RabbitMQ
# ========================================
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=60
RABBITMQ_BLOCKED_TIMEOUT=300
RABBITMQ_MAX_TASKS=5
RABBITMQ_RECORD_RESULT_QUEUE=record_result_queue

# 调用中心后台任务发布器
CONTROL_CENTER_INSTANCE_ID=
TASK_DISPATCH_BATCH_SIZE=20
TASK_DISPATCH_POLL_INTERVAL_SECONDS=1
TASK_DISPATCH_LOCK_TIMEOUT_SECONDS=300
TASK_DISPATCH_ERROR_BACKOFF_SECONDS=5
RECORDING_COMMAND_DISPATCH_BATCH_SIZE=20
RECORDING_COMMAND_DISPATCH_POLL_INTERVAL_SECONDS=1
RECORDING_COMMAND_DISPATCH_LOCK_TIMEOUT_SECONDS=10
RECORDING_COMMAND_DISPATCH_ERROR_BACKOFF_SECONDS=5
# 通用媒体 Worker 已直接执行业务回调，调用中心默认不消费通用任务完成事件。
CONTROL_CENTER_EVENT_CONSUMER_ENABLED=false
CONTROL_CENTER_EVENT_QUEUE_NAME=control-center.media-events
CONTROL_CENTER_EVENT_ROUTING_KEYS=task.completed,task.failed
CONTROL_CENTER_EVENT_PREFETCH_COUNT=10
CONTROL_CENTER_EVENT_RETRY_DELAY_MILLISECONDS=5000
CONTROL_CENTER_EVENT_MAX_ATTEMPTS=3
CONTROL_CENTER_EVENT_RECONNECT_DELAY_SECONDS=5
CONTROL_CENTER_CALLBACK_TIMEOUT_SECONDS=10
CONTENT_ANALYSIS_SERVICE_URL=http://127.0.0.1:8012
CONTENT_ANALYSIS_ADMIN_TIMEOUT_SECONDS=10

# 媒体节点心跳。配置调用中心地址后，录制节点和通用 Worker 默认自动上报。
MEDIA_NODE_HEARTBEAT_CONTROL_CENTER_URL=http://127.0.0.1:8008
MEDIA_NODE_AGENT_URL=http://127.0.0.1:8009
# 高级默认值：心跳间隔 30 秒，心跳请求超时 5 秒，节点权重 100。
# 普通节点不配置运行状态；能持续心跳就是 ONLINE，需要停接新任务时后续通过调用中心管理接口处理。

# ========================================
# 独立 AI 评课服务
# ========================================
CONTENT_ANALYSIS_OPENAI_API_KEY=change-me
CONTENT_ANALYSIS_OPENAI_BASE_URL=https://api.openai.com/v1
CONTENT_ANALYSIS_DEFAULT_MODEL=gpt-4.1
CONTENT_ANALYSIS_BEHAVIOR_API_URL=
CONTENT_ANALYSIS_PREFETCH_COUNT=1
CONTENT_ANALYSIS_EXECUTION_TIMEOUT_SECONDS=3600
CONTENT_ANALYSIS_LEASE_SECONDS=1800
CONTENT_ANALYSIS_LEASE_RENEW_SECONDS=600
CONTENT_ANALYSIS_LLM_TIMEOUT_SECONDS=180
CONTENT_ANALYSIS_LLM_MAX_RETRIES=3
CONTENT_ANALYSIS_MAX_FILE_SIZE_MB=100

# 通用媒体 Worker。启动后默认消费共享队列；运行实例 ID 自动生成。
MEDIA_WORKER_QUEUE_NAME=media-worker.tasks
MEDIA_WORKER_PREFETCH_COUNT=1
MEDIA_WORKER_CALLBACK_TIMEOUT_SECONDS=10
MEDIA_WORKER_CALLBACK_MAX_RETRIES=3
MEDIA_WORKER_CALLBACK_RETRY_INTERVAL_SECONDS=5
MEDIA_WORKER_EXECUTION_TIMEOUT_SECONDS=1800
MEDIA_WORKER_EXECUTION_LEASE_SECONDS=1800
MEDIA_WORKER_EXECUTION_LEASE_RENEW_SECONDS=600
# 高级默认值：MEDIA_WORKER_ROUTING_KEYS=#，MEDIA_WORKER_RETRY_DELAY_MILLISECONDS=5000，
# MEDIA_WORKER_EXECUTION_TIMEOUT_SECONDS=1800，MEDIA_WORKER_EXECUTION_LEASE_SECONDS=1800，
# MEDIA_WORKER_EXECUTION_LEASE_RENEW_SECONDS=600，MEDIA_WORKER_RECONNECT_DELAY_SECONDS=5。

# 录制节点定向命令队列
# 生产必须为每个录制节点配置稳定 RECORDER_NODE_ID；
# 队列名为 recorder.<RECORDER_NODE_ID>.commands。
RECORDER_NODE_ID=recorder-local-1
RECORDER_SERVER_ID=recording-server-local-1
RECORDER_NODE_MAX_RECORDINGS=100
# 最大粘性流绑定数，与同时录制路数分开核算；由调用中心在 MySQL 中原子占位。
RECORDER_NODE_MAX_BINDINGS=300
RECORDER_NODE_MIN_FREE_DISK_GB=10
ZLM_SERVER_ID=zlm-local-1
# 高级默认值：RECORDER_NODE_COMMAND_PREFETCH_COUNT=1，RECORDER_NODE_COMMAND_RETRY_DELAY_MILLISECONDS=5000，
# RECORDER_NODE_COMMAND_MAX_ATTEMPTS=3，RECORDER_NODE_COMMAND_RECONNECT_DELAY_SECONDS=5，
# RECORDER_NODE_COMMAND_ACCEPT_TIMEOUT_SECONDS=10。

# ========================================
# 存储
# ========================================
STORAGE_TYPE=minio
STORAGE_AUDIO_TYPE=minio
STORAGE_DOWNLOAD_PATH=./data/download

# MinIO
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=media
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_CALLBACK_URL=
MINIO_CALLBACK_TIMEOUT=30
MINIO_CALLBACK_MAX_RETRIES=3
MINIO_CALLBACK_FALLBACK_ENABLED=true
MINIO_APPID=
MINIO_FILEURL_HEAD=

# 腾讯云 COS
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-guangzhou
COS_BUCKET=
COS_DOMAIN=
COS_CALLBACK_URL=
COS_CALLBACK_TIMEOUT=30
COS_CALLBACK_MAX_RETRIES=3
COS_CALLBACK_FALLBACK_ENABLED=true
COS_APPID=
COS_FILEURL_HEAD=

# ========================================
# ZLMediaKit
# ========================================
ZLM_API_URL=http://127.0.0.1:8080
ZLM_URL=http://127.0.0.1:8080
ZLM_SECRET=change-me
# recorder 进程实际看到的路径。直接 uv 运行时填写本机路径；Docker/Portainer
# 运行时固定填写 volume 右侧的容器路径 /data/zlmediakit/record。
ZLM_RECORD_LOCAL_ROOT=/data/zlmediakit/record
# RTC 流媒体端点。play host 只配置统一域名或IP，不包含协议、端口和路径。
# 返回 RTC 的 server_id 取自 ZLM_SERVER_ID，只作为端口后的 /{server_id} 路由段；
# 不要在值中写斜杠，也不额外增加固定 /media 或 /channels 层。
# 示例最终播放地址：https://zlm.example.com:443/zlm-local-1/proxys/{streamId}.live.flv
ZLM_PLAY_HOST=zlm.example.com
ZLM_PLAY_PORT=443
ZLM_PLAY_PROTOCOL=https
ZLM_RTMP_PORT=1935
ZLM_RTSP_PORT=554

# ========================================
# 内部队列与任务
# ========================================
QUEUE_TYPE=memory
USE_REDIS_QUEUE=false
TASK_QUEUE_NAME=stream_media_tasks
TASK_CONCURRENCY=4
TASK_TIMEOUT=3600
TASK_CACHE_SIZE=1024
TASK_QUEUE_SIZE=1000
TASK_CLEANUP_ENABLED=true
TASK_CLEANUP_INTERVAL_HOURS=6
TASK_CLEANUP_KEEP_HOURS=48
TASK_CLEANUP_MEMORY_INTERVAL_MINUTES=30

# ========================================
# 节点注册与调用中心
# ========================================
NODE_HEARTBEAT_TIMEOUT=60
NODE_HEALTH_CHECK_INTERVAL=30
# 录制计划容量时段的开始/停止安全余量（秒）。
RECORDING_RESERVATION_MARGIN_SECONDS=5
NODE_REGISTRATION_ENDPOINT=/api/v1/node/register
NODE_HEARTBEAT_ENDPOINT=/api/v1/node/heartbeat

# ========================================
# 媒体处理
# ========================================
MEDIA_FFMPEG_PATH=ffmpeg
MEDIA_FFPROBE_PATH=ffprobe
MEDIA_TEMP_DIR=./data/temp
MEDIA_MAX_UPLOAD_SIZE=104857600
MEDIA_RECOG_CONCURRENCY=1
FLOW_TRACE_BASE_URL=

# 录像后处理
POST_PROCESSING_MAX_WORKERS=2
POST_PROCESSING_MEDIA_CONCURRENCY=2
# 闲时处理策略：达到阈值后按录制压力线性降低，满载默认保留50%后处理并发。
POST_PROCESSING_IDLE_STRATEGY_ENABLED=false
POST_PROCESSING_BUSY_RECORDING_THRESHOLD=50
POST_PROCESSING_BUSY_MEDIA_PERCENT=50
# 动态计算后的固定下限；0表示不额外设置下限。
POST_PROCESSING_BUSY_MEDIA_CONCURRENCY=1
POST_PROCESSING_IDLE_STRATEGY_POLL_INTERVAL_SECONDS=1
POST_PROCESSING_DB_SAVE_MAX_ATTEMPTS=5
POST_PROCESSING_DB_SAVE_RETRY_DELAY_SECONDS=5
# 任务内重试耗尽后写入 MySQL 等待，由 recorder-node 后台自动扫描并重新入队。
POST_PROCESSING_FAILED_AUTO_RETRY_ENABLED=true
POST_PROCESSING_FAILED_AUTO_RETRY_MAX_ATTEMPTS=3
POST_PROCESSING_FAILED_AUTO_RETRY_INITIAL_DELAY_SECONDS=60
POST_PROCESSING_FAILED_AUTO_RETRY_MAX_DELAY_SECONDS=900
POST_PROCESSING_FAILED_AUTO_RETRY_SCAN_INTERVAL_SECONDS=30
POST_PROCESSING_PRIORITY_HIGH=0
POST_PROCESSING_PRIORITY_NORMAL=10
POST_PROCESSING_PRIORITY_LOW=20
POST_PROCESSING_TIMEOUT_VIDEO_INFO=300
POST_PROCESSING_TIMEOUT_VIDEO_UPLOAD=3600
POST_PROCESSING_TIMEOUT_COVER_EXTRACT=300
POST_PROCESSING_TIMEOUT_COVER_UPLOAD=600
POST_PROCESSING_TIMEOUT_AUDIO_EXTRACT=1800
POST_PROCESSING_TIMEOUT_AUDIO_UPLOAD=1800

# 录像碎片清理
RECORD_CLEANUP_ENABLED=false
RECORD_CLEANUP_DRY_RUN=true
RECORD_CLEANUP_BASE_PATH=/data/app/zlmediakit/www/record
RECORD_CLEANUP_KEEP_DAYS=7
RECORD_CLEANUP_SCAN_HOUR=3

# ========================================
# 离线 ASR Worker
# ========================================
ASR_PROVIDER=funasr
FUNASR_MODEL_TYPE=paraformer
FUNASR_DEVICE=cpu
FUNASR_CPU_CONCURRENCY=1
FUNASR_GPU_CONCURRENCY=1
FUNASR_PRELOAD=true
FUNASR_DISABLE_UPDATE=true
FUNASR_NCPU=4
FUNASR_BATCH_SIZE_S=60
FUNASR_VAD_MAX_SEGMENT_MS=30000
FUNASR_MERGE_VAD=true
FUNASR_MERGE_LENGTH_S=15
FUNASR_PARAFORMER_ZH_MODEL=iic/speech_seaco_paraformer_large_asr_nat-zh-cn-16k-common-vocab8404-pytorch
FUNASR_PARAFORMER_EN_MODEL=iic/speech_paraformer_asr-en-16k-vocab4199-pytorch
FUNASR_VAD_MODEL=damo/speech_fsmn_vad_zh-cn-16k-common-pytorch
FUNASR_PUNC_MODEL=damo/punc_ct-transformer_zh-cn-common-vocab272727-pytorch
FUNASR_SPK_MODEL=damo/speech_campplus_sv_zh-cn_16k-common
FUNASR_SENSEVOICE_MODEL=iic/SenseVoiceSmall
FUNASR_SENSEVOICE_LANGUAGE=auto
FUNASR_SENSEVOICE_USE_ITN=true
FUNASR_SENSEVOICE_OUTPUT_TIMESTAMP=true
FUNASR_SENSEVOICE_TRUST_REMOTE_CODE=true

GLM_ASR_MODEL=/root/.cache/modelscope/hub/models/ZhipuAI/GLM-ASR-Nano-2512
GLM_ASR_DEVICE=cpu
GLM_ASR_CPU_CONCURRENCY=1
GLM_ASR_GPU_CONCURRENCY=1
GLM_ASR_PRELOAD=true
GLM_ASR_VAD_MODEL=fsmn-vad
GLM_ASR_BATCH_SIZE=32
GLM_ASR_MAX_GAP_MS=700
GLM_ASR_MAX_SEGMENT_MS=30000
GLM_ASR_MIN_SEGMENT_MS=800
GLM_ASR_RECOGNITION_CONTEXT_MS=0
GLM_ASR_MIN_RECOGNITION_MS=0
GLM_ASR_MAX_NEW_TOKENS=128
GLM_ASR_NO_REPEAT_NGRAM_SIZE=0
GLM_ASR_REPETITION_PENALTY=1.0
GLM_ASR_LENGTH_PENALTY=1.0
GLM_ASR_PROMPT=请将音频转写成简体中文文本。
GLM_ASR_KEEP_CHUNKS=false

# ========================================
# 监控与告警
# ========================================
MONITORING_ENABLED=false
MONITORING_COLLECT_INTERVAL=30
MONITORING_METRICS_PORT=9090
MONITORING_RETENTION_DAYS=7
MONITORING_CPU_WARNING=75
MONITORING_CPU_CRITICAL=90
MONITORING_MEMORY_WARNING=75
MONITORING_MEMORY_CRITICAL=90
MONITORING_DISK_WARNING=80
MONITORING_DISK_CRITICAL=90

ALERT_ENABLED=false
ALERT_CALLBACK_URL=
ALERT_RESOURCE_CALLBACK_URL=
ALERT_TIMEOUT=10
ALERT_MAX_RETRIES=3
ALERT_RETRY_INTERVAL=5
ALERT_COOLDOWN_MINUTES=10
