FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai \
    APP_TIMEZONE=Asia/Shanghai

ARG DEBIAN_MIRROR_HOST=""

RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/debian.sources && \
    if [ -n "${DEBIAN_MIRROR_HOST}" ]; then \
      sed -i "s/deb.debian.org/${DEBIAN_MIRROR_HOST}/g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    tzdata \
    ffmpeg \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo Asia/Shanghai > /etc/timezone \
    && rm -rf /var/lib/apt/lists/* \
    && ffmpeg -version \
    && ffprobe -version

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-cache --extra media-worker

COPY . /app
RUN test -f /app/services/media_worker/main.py && \
    .venv/bin/python -m compileall -q media_platform services/media_worker

EXPOSE 8009

CMD [".venv/bin/python", "-m", "services.media_worker.main"]
