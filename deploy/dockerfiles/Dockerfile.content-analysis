FROM python:3.12-slim-bookworm

COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /uvx /bin/

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Shanghai \
    APP_TIMEZONE=Asia/Shanghai

ARG DEBIAN_MIRROR_HOST=""

RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/debian.sources && \
    if [ -n "${DEBIAN_MIRROR_HOST}" ]; then \
      sed -i "s/deb.debian.org/${DEBIAN_MIRROR_HOST}/g" /etc/apt/sources.list.d/debian.sources; \
    fi && \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates tzdata tesseract-ocr tesseract-ocr-chi-sim \
    && ln -snf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo Asia/Shanghai > /etc/timezone \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-cache --extra content-analysis

COPY . /app
RUN .venv/bin/python -m compileall -q media_platform services/content_analysis

EXPOSE 8012
CMD [".venv/bin/python", "-m", "services.content_analysis.main"]
