# 快速联调只需要复制为仓库根目录 .env，或通过 QUICKSTART_ENV_FILE 指向实际环境文件。
# 依赖默认指向 Docker Desktop 宿主机；不用于现场部署。
CONTROL_CENTER_IMAGE=mediafleet-control-center:stable
MEDIA_WORKER_IMAGE=mediafleet-worker:stable
RECORDER_NODE_IMAGE=mediafleet-recorder-node:stable
DB_HOST=host.docker.internal
RABBITMQ_HOST=host.docker.internal
CONTROL_CENTER_PORT=8008
MEDIA_WORKER_PORT=8009
RECORDER_NODE_PORT=8010
ZLM_API_URL=http://host.docker.internal:8080
ZLM_URL=http://host.docker.internal:8080
# Windows 宿主机 ZL 的真实 www/record 目录，仅用于 volume 左侧。
ZLM_RECORD_PATH=E:/Test/ZLMediaKit/Debug/www/record
# quickstart 容器内固定路径，不能填写 Windows 宿主机路径。
ZLM_RECORD_LOCAL_ROOT=/data/zlmediakit/record
HOST_LOG_PATH=./.local/logs
HOST_TEMP_PATH=./.local/temp
