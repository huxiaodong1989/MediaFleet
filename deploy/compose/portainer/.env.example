# Portainer Stack 级变量。复制为 .env（或在 Portainer Stack environment variables 中填写）。
# 真实账号、密码、Secret、内网地址不要提交到仓库。
CONTROL_CENTER_IMAGE=mediafleet-control-center:develop-latest
RECORDER_NODE_IMAGE=mediafleet-recorder-node:develop-latest
MEDIA_WORKER_IMAGE=mediafleet-worker:develop-latest
MEDIA_WORKER_GPU_IMAGE=mediafleet-worker:gpu-latest
CONTENT_ANALYSIS_IMAGE=mediafleet-content-analysis:develop-latest

CONTROL_CENTER_PORT=8008
RECORDER_NODE_PORT=8010
MEDIA_WORKER_PORT=8009
MEDIA_WORKER_GPU_PORT=8009
CONTENT_ANALYSIS_PORT=8012
CONTROL_CENTER_BIND_IP=0.0.0.0
RECORDER_NODE_BIND_IP=0.0.0.0
MEDIA_WORKER_BIND_IP=0.0.0.0
MEDIA_WORKER_GPU_BIND_IP=0.0.0.0
CONTENT_ANALYSIS_BIND_IP=0.0.0.0

# 现场宿主机目录：录像节点必须指向对应 ZLMediaKit 的 www/record 目录。
# 宿主机 ZL 的真实 www/record 目录。Linux 示例：/srv/mediafleet/www/record
# recorder 容器内对应路径固定为 /data/zlmediakit/record。
ZLM_RECORD_PATH=/opt/zlmediakit/www/record
ZLM_RECORD_LOCAL_ROOT=/data/zlmediakit/record
CONTROL_CENTER_LOG_PATH=/opt/mediafleet/logs/control-center
RECORDER_NODE_LOG_PATH=/opt/mediafleet/logs/recorder-node
RECORDER_NODE_TEMP_PATH=/opt/mediafleet/temp/recorder-node
MEDIA_WORKER_LOG_PATH=/opt/mediafleet/logs/media-worker
MEDIA_WORKER_TEMP_PATH=/opt/mediafleet/temp/media-worker
MEDIA_WORKER_DATA_PATH=/opt/mediafleet/data/media-worker
MEDIA_WORKER_GPU_LOG_PATH=/opt/mediafleet/logs/media-worker-gpu
MEDIA_WORKER_GPU_TEMP_PATH=/opt/mediafleet/temp/media-worker-gpu
MEDIA_WORKER_GPU_DATA_PATH=/opt/mediafleet/data/media-worker-gpu
CONTENT_ANALYSIS_LOG_PATH=/opt/mediafleet/logs/content-analysis
CONTENT_ANALYSIS_TEMP_PATH=/opt/mediafleet/temp/content-analysis
CONTENT_ANALYSIS_DATA_PATH=/opt/mediafleet/data/content-analysis
MODELSCOPE_CACHE_PATH=/opt/mediafleet/models/modelscope
GPU_DEVICE_ID=0
NVIDIA_VISIBLE_DEVICES=0

# 以下是 Compose 中可覆盖的公共参数；业务变量也全部在 compose.yml 中有默认值。
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_USER=mediafleet
DB_PASSWORD=change-this-db-password
DB_NAME=mediafleet
RABBITMQ_HOST=rabbitmq.example.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=media_service
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_VHOST=/
MEDIA_WORKER_QUEUE_NAME=media-worker.tasks
ASR_PROVIDER=funasr
FUNASR_DEVICE=cpu
FUNASR_PRELOAD=true
GLM_ASR_DEVICE=cpu
STORAGE_TYPE=minio
MINIO_ENDPOINT=minio.example.internal:9000
MINIO_ACCESS_KEY=change-this-minio-access-key
MINIO_SECRET_KEY=change-this-minio-secret-key
MINIO_BUCKET=media
MINIO_FILEURL_HEAD=https://media.example.com/files
ZLM_API_URL=http://zlm.example.internal:8080
ZLM_URL=http://zlm.example.internal:8080
ZLM_SECRET=change-this-zlm-secret
ZLM_SERVER_ID=zlm-01
ZLM_PLAY_HOST=media.example.com
ZLM_PLAY_PORT=443
ZLM_PLAY_PROTOCOL=https
ZLM_RTMP_PORT=1935
ZLM_RTSP_PORT=554
RECORDER_NODE_ID=recorder-node-01
RECORDER_SERVER_ID=recording-server-01
MEDIA_NODE_HEARTBEAT_CONTROL_CENTER_URL=http://mediafleet-control-center:8008
MEDIA_WORKER_AGENT_URL=http://media-worker:8009
POST_PROCESSING_MAX_WORKERS=3
POST_PROCESSING_MEDIA_CONCURRENCY=2
POST_PROCESSING_IDLE_STRATEGY_ENABLED=false
POST_PROCESSING_BUSY_RECORDING_THRESHOLD=50
POST_PROCESSING_BUSY_MEDIA_PERCENT=50
POST_PROCESSING_BUSY_MEDIA_CONCURRENCY=1
POST_PROCESSING_IDLE_STRATEGY_POLL_INTERVAL_SECONDS=1
POST_PROCESSING_DB_SAVE_MAX_ATTEMPTS=5
POST_PROCESSING_DB_SAVE_RETRY_DELAY_SECONDS=5
POST_PROCESSING_FAILED_AUTO_RETRY_ENABLED=true
POST_PROCESSING_FAILED_AUTO_RETRY_MAX_ATTEMPTS=3
POST_PROCESSING_FAILED_AUTO_RETRY_INITIAL_DELAY_SECONDS=60
POST_PROCESSING_FAILED_AUTO_RETRY_MAX_DELAY_SECONDS=900
POST_PROCESSING_FAILED_AUTO_RETRY_SCAN_INTERVAL_SECONDS=30
FUNASR_CPU_CONCURRENCY=1
FUNASR_GPU_CONCURRENCY=2
GLM_ASR_MODEL=/root/.cache/modelscope/hub/models/ZhipuAI/GLM-ASR-Nano-2512
GLM_ASR_PRELOAD=true
GLM_ASR_GPU_CONCURRENCY=1
CONTROL_CENTER_API_KEY=change-this-api-key
RECORDER_NODE_API_KEY=change-this-api-key
MEDIA_WORKER_API_KEY=change-this-api-key
CONTENT_ANALYSIS_API_KEY=change-this-api-key
CONTENT_ANALYSIS_INSTANCE_ID=content-analysis-01
CONTENT_ANALYSIS_NODE_NAME=content-analysis-01
CONTENT_ANALYSIS_OPENAI_API_KEY=change-this-model-api-key
CONTENT_ANALYSIS_OPENAI_BASE_URL=https://api.openai.com/v1
CONTENT_ANALYSIS_DEFAULT_MODEL=gpt-4.1
CONTENT_ANALYSIS_BEHAVIOR_API_URL=
