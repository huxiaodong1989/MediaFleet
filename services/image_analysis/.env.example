# 由 Docker/部署平台注入环境变量；服务入口不自动读取此文件。
# 每个容器只运行一个 Uvicorn 进程，避免把并发额度重复放大。
APP_ENV=development
API_KEY=change-this-api-key
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8013
SERVICE_LOG_LEVEL=INFO
SERVICE_LOG_DIR=/app/logs

# MySQL 是任务、抽帧检查点和通知状态的事实来源。
DB_TYPE=mysql
DB_HOST=mysql.example.internal
DB_PORT=3306
DB_USER=mediafleet
DB_PASSWORD=change-this-db-password
DB_NAME=mediafleet
DB_AUTO_INIT=false
DB_AUTO_MIGRATE=false
DB_INIT_CREATE_SCHEMA=false

# 与调用中心使用同一个 RabbitMQ vhost。
RABBITMQ_HOST=rabbitmq.example.internal
RABBITMQ_PORT=5672
RABBITMQ_USER=media_service
RABBITMQ_PASSWORD=change-this-rabbitmq-password
RABBITMQ_VHOST=/
RABBITMQ_HEARTBEAT=60
RABBITMQ_BLOCKED_TIMEOUT=300
IMAGE_ANALYSIS_RESULT_EXCHANGE=image.analysis.result
IMAGE_ANALYSIS_RESULT_ROUTING_KEY=image.analysis.sample

# 节点身份和心跳。
IMAGE_ANALYSIS_INSTANCE_ID=image-analysis-01
MEDIA_NODE_NAME=image-analysis-01
MEDIA_NODE_WEIGHT=100
MEDIA_NODE_HEARTBEAT_CONTROL_CENTER_URL=http://mediafleet-control-center:8008
MEDIA_NODE_HEARTBEAT_INTERVAL_SECONDS=30
MEDIA_NODE_HEARTBEAT_TIMEOUT_SECONDS=5

# 消费者默认关闭。确认数据库迁移、Prompt、视频来源、对象存储和模型均可用后再开启。
IMAGE_ANALYSIS_CONSUMER_ENABLED=false
IMAGE_ANALYSIS_MAX_CONCURRENT_CLASSROOMS=4
IMAGE_ANALYSIS_FFMPEG_CONCURRENCY=4
IMAGE_ANALYSIS_DOWNLOAD_CONCURRENCY=1
IMAGE_ANALYSIS_UPLOAD_CONCURRENCY=4
IMAGE_ANALYSIS_MODEL_CONCURRENCY=4
IMAGE_ANALYSIS_FFMPEG_THREADS=1
IMAGE_ANALYSIS_DEFAULT_MODEL=
IMAGE_ANALYSIS_ALLOWED_MODELS=
IMAGE_ANALYSIS_OPENAI_API_KEY=
IMAGE_ANALYSIS_OPENAI_BASE_URL=https://api.openai.com/v1
IMAGE_ANALYSIS_STORAGE_PROVIDER=MINIO
IMAGE_ANALYSIS_VIDEO_ALLOWED_HOSTS=
IMAGE_ANALYSIS_VIDEO_ALLOWED_NETWORKS=
IMAGE_ANALYSIS_VIDEO_ALLOWED_PORTS=80,443
IMAGE_ANALYSIS_MAX_DOWNLOAD_BYTES=4000000000
IMAGE_ANALYSIS_MAX_PTS_ERROR_MS=5000
IMAGE_ANALYSIS_LEASE_SECONDS=600

# MinIO/S3 兼容存储。使用 COS 时改 IMAGE_ANALYSIS_STORAGE_PROVIDER 并填写下方 COS 配置。
MINIO_ENDPOINT=minio.example.internal:9000
MINIO_ACCESS_KEY=change-this-minio-access-key
MINIO_SECRET_KEY=change-this-minio-secret-key
MINIO_BUCKET=media
MINIO_SECURE=true
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
