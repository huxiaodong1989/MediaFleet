# 独立AI评课服务本地环境变量模板；禁止提交真实密码或模型密钥。
APP_ENV=development
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8012
SERVICE_LOG_LEVEL=INFO
SERVICE_DOTENV_ENABLED=true

API_KEY=change-me
MEDIA_NODE_HEARTBEAT_CONTROL_CENTER_URL=http://127.0.0.1:8008

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mediafleet
DB_CHARSET=utf8mb4
DB_AUTO_INIT=true
DB_AUTO_MIGRATE=true

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/

CONTENT_ANALYSIS_OPENAI_API_KEY=change-me
CONTENT_ANALYSIS_OPENAI_BASE_URL=https://api.openai.com/v1
CONTENT_ANALYSIS_DEFAULT_MODEL=gpt-4.1
CONTENT_ANALYSIS_BEHAVIOR_API_URL=
CONTENT_ANALYSIS_PREFETCH_COUNT=1
CONTENT_ANALYSIS_EXECUTION_TIMEOUT_SECONDS=3600
CONTENT_ANALYSIS_LEASE_SECONDS=1800
CONTENT_ANALYSIS_LEASE_RENEW_SECONDS=600
CONTENT_ANALYSIS_LLM_TIMEOUT_SECONDS=180
CONTENT_ANALYSIS_LLM_MAX_RETRIES=3
CONTENT_ANALYSIS_MAX_FILE_SIZE_MB=100
