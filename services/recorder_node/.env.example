# 录制节点本地环境变量模板
# 启动后默认上报心跳并消费本节点命令队列。

APP_ENV=development
SERVICE_HOST=127.0.0.1
SERVICE_DOTENV_ENABLED=true
SERVICE_PORT=8010
SERVICE_LOG_LEVEL=INFO

# 节点心跳。配置调用中心地址后自动上报 ZL 地址、录像能力和后处理队列容量。
API_KEY=change-me
MEDIA_NODE_HEARTBEAT_CONTROL_CENTER_URL=http://127.0.0.1:8008
MEDIA_NODE_AGENT_URL=http://127.0.0.1:8010
RECORDER_NODE_MAX_RECORDINGS=100
# 最大粘性流绑定数，与同时录制路数分开核算；由调用中心在 MySQL 中原子占位。
RECORDER_NODE_MAX_BINDINGS=300
ZLM_SERVER_ID=zlm-local-1

# 录制单元稳定身份。它代表固定配对的 ZL + recorder-node + 录像目录，跨重启不变。
# 本地未配置时复用 RECORDER_NODE_ID；正式多节点部署必须显式配置且全局唯一。
RECORDER_SERVER_ID=recording-server-local-1
# 录像盘低于该可用空间时上报 NOT_READY，调用中心不再分配新绑定。
RECORDER_NODE_MIN_FREE_DISK_GB=10

# 录制节点身份。生产环境必须配置稳定值；该值决定 RabbitMQ 队列：
# recorder.<RECORDER_NODE_ID>.commands
RECORDER_NODE_ID=recorder-local-1
RECORDER_NODE_COMMAND_PREFETCH_COUNT=1
# 高级默认值：重试延迟 5000 毫秒，最大尝试 3 次，重连间隔 5 秒，命令接受超时 10 秒。

# 本机 ZLMediaKit，Secret 不要提交真实值
ZLM_API_URL=http://127.0.0.1:8080
ZLM_URL=http://127.0.0.1:8080
ZLM_SECRET=change-me
# recorder 进程实际可读的 ZL 录像根目录，服务运行方式不同，填写方式不同：
# Windows 直接 uv：E:/Test/ZLMediaKit/Debug/www/record
# Linux 直接 uv：/srv/mediafleet/www/record
# Docker/Portainer：/data/zlmediakit/record（Compose volume 右侧路径）
ZLM_RECORD_LOCAL_ROOT=/data/zlmediakit/record
# 返回 RTC 的流媒体端点。server_id 取自 ZLM_SERVER_ID，并直接作为播放端口后的
# 单层 Nginx 路由段；不要填写斜杠，也不额外增加 /media 或 /channels。
ZLM_PLAY_HOST=zlm.example.com
ZLM_PLAY_PORT=443
ZLM_PLAY_PROTOCOL=https
ZLM_RTMP_PORT=1935
ZLM_RTSP_PORT=554

# 录制尾链路并发：Worker 控制同时处理的任务数，media 限制其中
# 扫描、ffprobe、合并、音频和封面等重 IO/FFmpeg 操作。
POST_PROCESSING_MAX_WORKERS=3
POST_PROCESSING_MEDIA_CONCURRENCY=2
# 默认关闭。开启后，无录制时后处理使用全量并发；达到阈值后随录制压力
# 线性下降，录制满载时默认仍保留 50% 重 IO/FFmpeg 并发。
POST_PROCESSING_IDLE_STRATEGY_ENABLED=false
POST_PROCESSING_BUSY_RECORDING_THRESHOLD=50
# 满载保留比例；固定并发只作为动态计算后的可选下限，0 表示不额外设置下限。
POST_PROCESSING_BUSY_MEDIA_PERCENT=50
POST_PROCESSING_BUSY_MEDIA_CONCURRENCY=1
POST_PROCESSING_IDLE_STRATEGY_POLL_INTERVAL_SECONDS=1
# db_save 瞬时连接/协议错误的有限指数退避重试。
POST_PROCESSING_DB_SAVE_MAX_ATTEMPTS=5
POST_PROCESSING_DB_SAVE_RETRY_DELAY_SECONDS=5
# 任务内重试耗尽后持久化等待，并由 recorder-node 自动重新入队；人工接口只作兜底。
POST_PROCESSING_FAILED_AUTO_RETRY_ENABLED=true
POST_PROCESSING_FAILED_AUTO_RETRY_MAX_ATTEMPTS=3
POST_PROCESSING_FAILED_AUTO_RETRY_INITIAL_DELAY_SECONDS=60
POST_PROCESSING_FAILED_AUTO_RETRY_MAX_DELAY_SECONDS=900
POST_PROCESSING_FAILED_AUTO_RETRY_SCAN_INTERVAL_SECONDS=30

# 数据库
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=mediafleet

# RabbitMQ
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
